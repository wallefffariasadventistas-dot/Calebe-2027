rules_version = '2';

// Regras do Calebe 2027
// O acesso é controlado pelo próprio sistema (telefone + senha de 6 números).
// Sem login do Google, o banco precisa permitir leitura e escrita nas coleções do Calebe.
service cloud.firestore {
  match /databases/{database}/documents {
    match /calebe_usuarios/{id} {
      allow read, write: if true;
    }
    match /calebe_equipes/{id} {
      allow read, write: if true;
    }
    match /calebe_config/{id} {
      allow read, write: if true;
    }
  }
}
